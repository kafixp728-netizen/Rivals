-- -------------------------------------------------------
-- DEEP SCAN SPOOFING ENGINE
-- -------------------------------------------------------
local function spoofElement(element)
    if element:IsA("TextLabel") or element:IsA("TextBox") then
        local text = element.Text
        local name = element.Name:lower()
        
        -- Matches 'Lvl 12', 'LVL 100', 'Level 50', or elements named level/lvl containing numbers
        if text:find("Lvl") or text:find("LVL") or text:find("Level") then
            local prefix = text:match("^(%a+%s*)") or "Level "
            element.Text = prefix .. ACTIVE_LEVEL
        elseif name:find("level") or name:find("lvl") or name == "levelnum" then
            if tonumber(text) or text:match("^%d+$") then
                element.Text = ACTIVE_LEVEL
            end
        end
    end
end

local function scanAndSpoof()
    if not SpoofEnabled then return end
    
    -- Fast scan across PlayerGui
    for _, child in pairs(PlayerGui:GetDescendants()) do
        spoofElement(child)
    end
end

