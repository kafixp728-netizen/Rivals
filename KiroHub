    if KeyInput.Text == "Gemini" then
        KeyFrame.Visible = false
        SpooferFrame.Visible = true
        StatusLabel.Text = "Status: Key Accepted! Enter level below."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
    else
        StatusLabel.Text = "Status: Wrong Key!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        KeyInput.Text = ""
    end
end)

ApplyBtn.MouseButton1Click:Connect(function()
    if LevelInput.Text ~= "" then
        ACTIVE_LEVEL = LevelInput.Text
        SpoofEnabled = true
        
        -- Initial instant spoof scan
        scanAndSpoof()
        
        StatusLabel.Text = "Status: ACTIVE (Level " .. ACTIVE_LEVEL .. ")"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
    end
end)

-- Continuous RenderStepped pulse loop to lock the UI visually
RunService.RenderStepped:Connect(function()
    if SpoofEnabled then
        scanAndSpoof()
    end
end)

